# This tree cannot resolve with npm's strict peer rules: react-native-windows is
# an OPTIONAL peer of @react-native-community/datetimepicker, and npm still
# fails resolution over it. Every install needs --legacy-peer-deps.
#
# Kept here rather than as a flag people remember to type, because the places
# that install without a human present are exactly the ones that break: EAS
# Build runs `npm ci` on its own, and a stale or unresolvable lockfile fails the
# build in the Install dependencies phase before anything compiles.
legacy-peer-deps=true
